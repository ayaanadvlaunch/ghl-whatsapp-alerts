# Public hostname for your VM. nip.io turns an IP into a hostname for free (no domain needed).
# Replace dots with dashes: IP 132.145.67.89 -> 132-145-67-89.nip.io
PUBLIC_HOSTNAME=YOUR-IP-WITH-DASHES.nip.io

# Generate each with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=
WAHA_API_KEY=
GHL_WEBHOOK_SECRET=

# Who receives the alert. Either a person or a group:
#   person: country code + number, no "+" or spaces, then @c.us   e.g. 64211234567@c.us
#   group : find the id with scripts/list-groups.sh                e.g. 120363xxxxxxxxxxxx@g.us
WHATSAPP_TO=

# Timezone used by n8n (affects any times n8n formats itself)
TZ=Pacific/Auckland
